# ==============================================================================
# Equinox - Plantilla de variables de entorno para PRODUCCIÓN (Docker + Linux)
# Copiar a .env en el servidor y completar con valores reales antes de desplegar.
# NUNCA subir el archivo .env real al repositorio.
# ==============================================================================

# --- Imágenes Docker (usadas por compose.prod.yml en deploy por SSH) ---
BACKEND_IMAGE=ghcr.io/tu-usuario/equinox-backend
MIGRATOR_IMAGE=ghcr.io/tu-usuario/equinox-migrator
FRONTEND_IMAGE=ghcr.io/tu-usuario/equinox-frontend
IMAGE_TAG=latest

# --- Base de datos PostgreSQL (contenedor db) ---
POSTGRES_DB=equinox
POSTGRES_USER=equinox
POSTGRES_PASSWORD=cambia-esta-contrasena-postgres-larga-y-aleatoria

# --- Seguridad y autenticación ---
# Generar con: openssl rand -hex 32
SECRETO_JWT=cambia-esto-por-un-secreto-jwt-largo-y-aleatorio-de-64-hex
# Opcional (si se omite, deriva de SECRETO_JWT)
SECRETO_MFA=
VENCIMIENTO_JWT=7d
VENCIMIENTO_JWT_ADMIN=8h

# --- Orígenes, Proxy y Red ---
# URL pública desde donde los usuarios acceden al frontend (sin barra final)
URL_BASE=https://equinox.tu-dominio.com
# Lista separada por comas de orígenes permitidos por CORS (sin comodín *)
ORIGENES_PERMITIDOS=https://equinox.tu-dominio.com
# Origen de la API inyectado en el frontend en tiempo de ejecución:
# - same-origin: usa window.location.origin (Nginx hace proxy de /api y /salud hacia backend)
# - o un origen explícito https://api.tu-dominio.com
EQUINOX_API_ORIGIN=same-origin
# Saltos de proxy de confianza (1 cuando Nginx está delante de backend; 2 si además hay proxy TLS externo)
CONFIAR_PROXY=1

# Exposición de Nginx en el host Linux:
# 127.0.0.1 para acceso por túnel SSH o reverse proxy local (Caddy/Nginx/Cloudflared)
# 0.0.0.0 para acceso directo en LAN
FRONTEND_BIND_IP=127.0.0.1
FRONTEND_PORT=8080

# --- Almacenamiento persistente ---
# Las migraciones se ejecutan vía el servicio one-shot 'migrator' antes de iniciar 'backend'.
# Límite por foto en bytes (52428800 = 50 MB)
ALMACENAMIENTO_MAX_BYTES=52428800

# --- Invitaciones ---
VENCIMIENTO_INVITACION_HORAS=168

# --- Correo saliente SMTP (opcional) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Equinox <no-reply@equinox.app>"

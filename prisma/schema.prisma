generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RolMiembro {
  PROPIETARIO
  COLABORADOR
}

enum TipoFreelance {
  GENERAL
  DESARROLLO_SOFTWARE
  FOTOGRAFIA
  DISENO_GRAFICO
}

enum EstadoSesionFotografica {
  BORRADOR
  PUBLICADA
}

enum RolCliente {
  TITULAR
  COLABORADOR
}

enum EstadoInvitacionCliente {
  PENDIENTE
  ACEPTADA
  REVOCADA
  EXPIRADA
}

enum EstadoCliente {
  ACTIVO
  INACTIVO
  PROSPECTO
  ARCHIVADO
}

enum EstadoProyecto {
  BORRADOR
  ACTIVO
  PAUSADO
  COMPLETADO
  CANCELADO
}

enum PrioridadTarea {
  BAJA
  MEDIA
  ALTA
  URGENTE
}

enum EstadoTarea {
  PENDIENTE
  EN_PROGRESO
  BLOQUEADA
  COMPLETADA
  CANCELADA
}

enum EstadoHito {
  PENDIENTE
  EN_PROGRESO
  COMPLETADO
  VENCIDO
}

enum TipoArchivo {
  ARCHIVO
  ENTREGABLE
  IMAGEN
  DOCUMENTO
}

enum VisibilidadArchivo {
  INTERNA
  CLIENTE
}

enum AutorComentario {
  FREELANCER
  CLIENTE
}

enum EstadoFactura {
  BORRADOR
  ENVIADA
  PAGADA
  VENCIDA
  CANCELADA
}

enum RolPlataforma {
  USUARIO
  ADMIN_GLOBAL
}

enum IdiomaUsuario {
  es
  en
  pt
}

enum TipoAccesoSesion {
  ORGANIZACION
  CLIENTE
  ADMIN_GLOBAL
}

enum EstadoSuscripcion {
  SIN_SUSCRIPCION
  PRUEBA
  ACTIVA
  SUSPENDIDA
  CANCELADA
}

model Usuario {
  id                    String                @id @default(uuid()) @db.Uuid
  correo                String                @unique
  contrasenaHash        String                @map("contrasena_hash")
  nombre                String
  apellido              String?
  telefono              String?
  zonaHoraria           String                @default("America/Panama") @map("zona_horaria")
  idioma                IdiomaUsuario         @default(es) @map("idioma")
  avatarUrl             String?               @map("avatar_url")
  correoVerificadoEn    DateTime?             @map("correo_verificado_en")
  ultimoAccesoEn        DateTime?             @map("ultimo_acceso_en")
  rolPlataforma         RolPlataforma         @default(USUARIO) @map("rol_plataforma")
  mfaHabilitado         Boolean               @default(false) @map("mfa_habilitado")
  mfaSecretoCifrado     String?               @map("mfa_secreto_cifrado")
  mfaPendienteSecretoCifrado String?          @map("mfa_pendiente_secreto_cifrado")
  mfaVerificadoEn       DateTime?             @map("mfa_verificado_en")
  mfaUltimoPasoUsado    BigInt?               @map("mfa_ultimo_paso_usado")
  creadoEn              DateTime              @default(now()) @map("creado_en")
  actualizadoEn         DateTime              @updatedAt @map("actualizado_en")
  membresias            MiembroOrganizacion[]
  accesosCliente        AccesoCliente[]
  invitacionesEnviadas  InvitacionCliente[]   @relation("InvitacionesEnviadas")
  invitacionesAceptadas InvitacionCliente[]   @relation("InvitacionesAceptadas")
  sesiones              Sesion[]
  actividades           Actividad[]
  comentarios           Comentario[]
  tareasAsignadas       Tarea[]               @relation("TareasAsignadas")
  creadoPor             Proyecto[]            @relation("ProyectoCreadoPor")
  solicitudesRecuperacion SolicitudRecuperacion[]
  codigosRecuperacionMfa CodigoRecuperacionMfa[]
  solicitudesRecuperacionMfa SolicitudRecuperacionMfa[]
  auditoriasAdmin       AuditoriaAdmin[]      @relation("AuditoriaActor")
  planesCreados         PlanSuscripcion[]     @relation("PlanCreadoPor")
  planesActualizados    PlanSuscripcion[]     @relation("PlanActualizadoPor")
  suscripcionesAsignadas SuscripcionOrganizacion[] @relation("SuscripcionAsignadaPor")
  suscripcionesCanceladas SuscripcionOrganizacion[] @relation("SuscripcionCanceladaPor")
  historialSuscripciones HistorialSuscripcion[] @relation("HistorialSuscripcionUsuario")
  historialFacturas     HistorialFactura[]
  pagosRegistrados      Pago[]

  @@map("usuarios")
}

model Organizacion {
  id                    String                @id @default(uuid()) @db.Uuid
  nombre                String
  slug                  String                @unique
  descripcion           String?
  moneda                String                @default("PAB")
  ruc                   String?
  direccion             String?
  telefono              String?
  correoContacto        String?               @map("correo_contacto")
  logoUrl               String?               @map("logo_url")
  colorPrimario         String                @default("#2563EB") @map("color_primario")
  colorSecundario       String                @default("#0F172A") @map("color_secundario")
  tipografia            String                @default("Inter")
  portalMensajeBienvenida String?             @map("portal_mensaje_bienvenida")
  dominioPortal         String?               @unique @map("dominio_portal")
  portalMostrarFinanzas Boolean               @default(false) @map("portal_mostrar_finanzas")
  tipoFreelance         TipoFreelance         @default(GENERAL) @map("tipo_freelance")
  suspendidaEn          DateTime?             @map("suspendida_en")
  motivoSuspension      String?               @map("motivo_suspension")
  suspendidaPorUsuarioId String?              @map("suspendida_por_usuario_id") @db.Uuid
  creadoEn              DateTime              @default(now()) @map("creado_en")
  actualizadoEn         DateTime              @updatedAt @map("actualizado_en")
  miembros              MiembroOrganizacion[]
  accesosCliente        AccesoCliente[]
  invitacionesCliente   InvitacionCliente[]
  clientes              Cliente[]
  proyectos             Proyecto[]
  facturas              Factura[]
  secuenciaFactura      SecuenciaFactura?
  actividades           Actividad[]
  sesionesFotograficas  SesionFotografica[]
  suscripcion           SuscripcionOrganizacion?
  historialSuscripciones HistorialSuscripcion[]

  @@index([suspendidaEn])
  @@map("organizaciones")
}

model MiembroOrganizacion {
  id             String       @id @default(uuid()) @db.Uuid
  usuarioId      String       @map("usuario_id") @db.Uuid
  organizacionId String       @map("organizacion_id") @db.Uuid
  rol            RolMiembro   @default(COLABORADOR)
  creadoEn       DateTime     @default(now()) @map("creado_en")
  usuario        Usuario      @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  organizacion   Organizacion @relation(fields: [organizacionId], references: [id], onDelete: Cascade)

  @@unique([usuarioId, organizacionId])
  @@map("miembros_organizacion")
}

model Cliente {
  id                  String              @id @default(uuid()) @db.Uuid
  organizacionId      String              @map("organizacion_id") @db.Uuid
  nombre              String
  empresa             String?
  correo              String?
  telefono            String?
  direccion           String?
  sitioWeb            String?             @map("sitio_web")
  notasInternas       String?             @map("notas_internas")
  estado              EstadoCliente       @default(ACTIVO)
  creadoEn            DateTime            @default(now()) @map("creado_en")
  actualizadoEn       DateTime            @updatedAt @map("actualizado_en")
  organizacion        Organizacion        @relation(fields: [organizacionId], references: [id], onDelete: Cascade)
  accesosCliente      AccesoCliente[]
  invitacionesCliente InvitacionCliente[]
  proyectos           Proyecto[]
  accesosPortal       AccesoPortal[]
  facturas            Factura[]
  sesionesFotograficas SesionFotografica[]

  @@unique([id, organizacionId])
  @@index([organizacionId, estado])
  @@map("clientes")
}

model AccesoCliente {
  id             String       @id @default(uuid()) @db.Uuid
  usuarioId      String       @map("usuario_id") @db.Uuid
  clienteId      String       @map("cliente_id") @db.Uuid
  organizacionId String       @map("organizacion_id") @db.Uuid
  rol            RolCliente   @default(TITULAR)
  activo         Boolean      @default(true)
  ultimoAccesoEn DateTime?    @map("ultimo_acceso_en")
  creadoEn       DateTime     @default(now()) @map("creado_en")
  actualizadoEn  DateTime     @updatedAt @map("actualizado_en")
  usuario        Usuario      @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  cliente        Cliente      @relation(fields: [clienteId, organizacionId], references: [id, organizacionId], onDelete: Cascade)
  organizacion   Organizacion @relation(fields: [organizacionId], references: [id], onDelete: Cascade)

  @@unique([usuarioId, clienteId])
  @@index([organizacionId, activo])
  @@index([clienteId])
  @@index([usuarioId])
  @@map("accesos_cliente")
}

model InvitacionCliente {
  id             String                  @id @default(uuid()) @db.Uuid
  organizacionId String                  @map("organizacion_id") @db.Uuid
  clienteId      String                  @map("cliente_id") @db.Uuid
  correo         String
  tokenHash      String                  @unique @map("token_hash")
  rol            RolCliente              @default(TITULAR)
  estado         EstadoInvitacionCliente @default(PENDIENTE)
  expiraEn       DateTime                @map("expira_en")
  aceptadaEn     DateTime?               @map("aceptada_en")
  invitadoPorId  String                  @map("invitado_por_id") @db.Uuid
  aceptadaPorId  String?                 @map("aceptada_por_id") @db.Uuid
  creadoEn       DateTime                @default(now()) @map("creado_en")
  actualizadoEn  DateTime                @updatedAt @map("actualizado_en")
  organizacion   Organizacion            @relation(fields: [organizacionId], references: [id], onDelete: Cascade)
  cliente        Cliente                 @relation(fields: [clienteId, organizacionId], references: [id, organizacionId], onDelete: Cascade)
  invitadoPor    Usuario                 @relation("InvitacionesEnviadas", fields: [invitadoPorId], references: [id], onDelete: Restrict)
  aceptadaPor    Usuario?                @relation("InvitacionesAceptadas", fields: [aceptadaPorId], references: [id], onDelete: SetNull)

  @@index([organizacionId, estado])
  @@index([clienteId])
  @@index([correo])
  @@index([expiraEn])
  @@map("invitaciones_cliente")
}

model Proyecto {
  id             String         @id @default(uuid()) @db.Uuid
  organizacionId String         @map("organizacion_id") @db.Uuid
  clienteId      String         @map("cliente_id") @db.Uuid
  creadoPorId    String         @map("creado_por_id") @db.Uuid
  nombre         String
  descripcion    String?
  estado         EstadoProyecto @default(BORRADOR)
  presupuesto    Decimal?       @db.Decimal(12, 2)
  moneda         String         @default("PAB")
  fechaInicio    DateTime?      @map("fecha_inicio") @db.Date
  fechaEntrega   DateTime?      @map("fecha_entrega") @db.Date
  completadoEn   DateTime?      @map("completado_en")
  creadoEn       DateTime       @default(now()) @map("creado_en")
  actualizadoEn  DateTime       @updatedAt @map("actualizado_en")
  organizacion   Organizacion   @relation(fields: [organizacionId], references: [id], onDelete: Cascade)
  cliente        Cliente        @relation(fields: [clienteId], references: [id], onDelete: Restrict)
  creadoPor      Usuario        @relation("ProyectoCreadoPor", fields: [creadoPorId], references: [id], onDelete: Restrict)
  tareas         Tarea[]
  hitos          Hito[]
  archivos       Archivo[]
  comentarios    Comentario[]
  accesosPortal  AccesoPortal[]
  facturas       Factura[]

  @@index([organizacionId, estado])
  @@index([clienteId])
  @@map("proyectos")
}

model Tarea {
  id               String         @id @default(uuid()) @db.Uuid
  proyectoId       String         @map("proyecto_id") @db.Uuid
  hitoId           String?        @map("hito_id") @db.Uuid
  asignadoAId      String?        @map("asignado_a_id") @db.Uuid
  titulo           String
  descripcion      String?
  estado           EstadoTarea    @default(PENDIENTE)
  prioridad        PrioridadTarea @default(MEDIA)
  orden            Int            @default(0)
  fechaVencimiento DateTime?      @map("fecha_vencimiento") @db.Date
  completadaEn     DateTime?      @map("completada_en")
  creadoEn         DateTime       @default(now()) @map("creado_en")
  actualizadoEn    DateTime       @updatedAt @map("actualizado_en")
  proyecto         Proyecto       @relation(fields: [proyectoId], references: [id], onDelete: Cascade)
  hito             Hito?          @relation(fields: [hitoId], references: [id], onDelete: SetNull)
  asignadoA        Usuario?       @relation("TareasAsignadas", fields: [asignadoAId], references: [id], onDelete: SetNull)

  @@index([proyectoId, estado])
  @@map("tareas")
}

model Hito {
  id              String     @id @default(uuid()) @db.Uuid
  proyectoId      String     @map("proyecto_id") @db.Uuid
  titulo          String
  descripcion     String?
  estado          EstadoHito @default(PENDIENTE)
  orden           Int        @default(0)
  fechaObjetivo   DateTime?  @map("fecha_objetivo") @db.Date
  completadoEn    DateTime?  @map("completado_en")
  visibleEnPortal Boolean    @default(false) @map("visible_en_portal")
  creadoEn        DateTime   @default(now()) @map("creado_en")
  actualizadoEn   DateTime   @updatedAt @map("actualizado_en")
  proyecto        Proyecto   @relation(fields: [proyectoId], references: [id], onDelete: Cascade)
  tareas          Tarea[]

  @@index([proyectoId, orden])
  @@map("hitos")
}

model Archivo {
  id             String             @id @default(uuid()) @db.Uuid
  proyectoId     String             @map("proyecto_id") @db.Uuid
  nombre         String
  nombreOriginal String             @map("nombre_original")
  url            String
  tipoMime       String             @map("tipo_mime")
  tamanoBytes    Int                @map("tamano_bytes")
  tipo           TipoArchivo        @default(ARCHIVO)
  visibilidad    VisibilidadArchivo @default(INTERNA)
  descripcion    String?
  publicadoEn    DateTime?          @map("publicado_en")
  creadoEn       DateTime           @default(now()) @map("creado_en")
  actualizadoEn  DateTime           @updatedAt @map("actualizado_en")
  proyecto       Proyecto           @relation(fields: [proyectoId], references: [id], onDelete: Cascade)

  @@index([proyectoId, visibilidad])
  @@map("archivos")
}

model Comentario {
  id             String          @id @default(uuid()) @db.Uuid
  proyectoId     String          @map("proyecto_id") @db.Uuid
  usuarioId      String?         @map("usuario_id") @db.Uuid
  accesoPortalId String?         @map("acceso_portal_id") @db.Uuid
  autor          AutorComentario
  contenido      String
  creadoEn       DateTime        @default(now()) @map("creado_en")
  actualizadoEn  DateTime        @updatedAt @map("actualizado_en")
  proyecto       Proyecto        @relation(fields: [proyectoId], references: [id], onDelete: Cascade)
  usuario        Usuario?        @relation(fields: [usuarioId], references: [id], onDelete: SetNull)
  accesoPortal   AccesoPortal?   @relation(fields: [accesoPortalId], references: [id], onDelete: SetNull)

  @@index([proyectoId, creadoEn])
  @@map("comentarios")
}

// Modelo heredado conservado para no eliminar datos existentes en esta migración.
// La API ya no crea ni acepta tokens de AccesoPortal.
model AccesoPortal {
  id             String       @id @default(uuid()) @db.Uuid
  clienteId      String       @map("cliente_id") @db.Uuid
  proyectoId     String?      @map("proyecto_id") @db.Uuid
  token          String       @unique
  nombre         String?
  correo         String?
  activo         Boolean      @default(true)
  expiraEn       DateTime?    @map("expira_en")
  ultimoAccesoEn DateTime?    @map("ultimo_acceso_en")
  creadoEn       DateTime     @default(now()) @map("creado_en")
  cliente        Cliente      @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  proyecto       Proyecto?    @relation(fields: [proyectoId], references: [id], onDelete: Cascade)
  comentarios    Comentario[]

  @@index([clienteId, activo])
  @@map("accesos_portal")
}

model Factura {
  id               String             @id @default(uuid()) @db.Uuid
  organizacionId   String             @map("organizacion_id") @db.Uuid
  clienteId        String             @map("cliente_id") @db.Uuid
  proyectoId       String?            @map("proyecto_id") @db.Uuid
  numero           String
  concepto         String
  monto            Decimal            @db.Decimal(12, 2)
  moneda           String             @default("PAB")
  estado           EstadoFactura      @default(BORRADOR)
  visibleEnPortal  Boolean            @default(true) @map("visible_en_portal")
  fechaEmision     DateTime           @default(now()) @map("fecha_emision") @db.Date
  fechaVencimiento DateTime?          @map("fecha_vencimiento") @db.Date
  pagadaEn         DateTime?          @map("pagada_en")
  notas            String?
  creadoEn         DateTime           @default(now()) @map("creado_en")
  actualizadoEn    DateTime           @updatedAt @map("actualizado_en")
  organizacion     Organizacion       @relation(fields: [organizacionId], references: [id], onDelete: Cascade)
  cliente          Cliente            @relation(fields: [clienteId], references: [id], onDelete: Restrict)
  proyecto         Proyecto?          @relation(fields: [proyectoId], references: [id], onDelete: SetNull)
  historial        HistorialFactura[]
  pagos            Pago[]

  @@unique([organizacionId, numero])
  @@index([organizacionId, estado])
  @@index([clienteId, visibleEnPortal])
  @@map("facturas")
}

model HistorialFactura {
  id             String         @id @default(uuid()) @db.Uuid
  facturaId      String         @map("factura_id") @db.Uuid
  estadoAnterior EstadoFactura? @map("estado_anterior")
  estadoNuevo    EstadoFactura  @map("estado_nuevo")
  usuarioId      String?        @map("usuario_id") @db.Uuid
  motivo         String?
  creadoEn       DateTime       @default(now()) @map("creado_en")
  factura        Factura        @relation(fields: [facturaId], references: [id], onDelete: Cascade)
  usuario        Usuario?       @relation(fields: [usuarioId], references: [id], onDelete: SetNull)

  @@index([facturaId, creadoEn])
  @@map("historial_facturas")
}

model Pago {
  id              String       @id @default(uuid()) @db.Uuid
  facturaId       String       @map("factura_id") @db.Uuid
  monto           Decimal      @db.Decimal(12, 2)
  moneda          String       @default("PAB")
  metodo          String?
  referencia      String?
  notas           String?
  registradoPorId String?      @map("registrado_por_id") @db.Uuid
  creadoEn        DateTime     @default(now()) @map("creado_en")
  factura         Factura      @relation(fields: [facturaId], references: [id], onDelete: Cascade)
  registradoPor   Usuario?     @relation(fields: [registradoPorId], references: [id], onDelete: SetNull)

  @@index([facturaId, creadoEn])
  @@map("pagos")
}

model SecuenciaFactura {
  id             String       @id @default(uuid()) @db.Uuid
  organizacionId String       @unique @map("organizacion_id") @db.Uuid
  ultimoNumero   Int          @default(0) @map("ultimo_numero")
  actualizadoEn  DateTime     @updatedAt @map("actualizado_en")
  organizacion   Organizacion @relation(fields: [organizacionId], references: [id], onDelete: Cascade)

  @@map("secuencias_facturas")
}

model Actividad {
  id             String       @id @default(uuid()) @db.Uuid
  organizacionId String       @map("organizacion_id") @db.Uuid
  usuarioId      String?      @map("usuario_id") @db.Uuid
  entidad        String
  entidadId      String       @map("entidad_id")
  accion         String
  descripcion    String?
  metadatos      Json?
  creadoEn       DateTime     @default(now()) @map("creado_en")
  organizacion   Organizacion @relation(fields: [organizacionId], references: [id], onDelete: Cascade)
  usuario        Usuario?     @relation(fields: [usuarioId], references: [id], onDelete: SetNull)

  @@index([organizacionId, creadoEn])
  @@index([entidad, entidadId])
  @@map("actividades")
}

model Sesion {
  id              String           @id @default(uuid()) @db.Uuid
  usuarioId       String           @map("usuario_id") @db.Uuid
  tokenHash       String           @unique @map("token_hash")
  tipoAcceso      TipoAccesoSesion @default(ORGANIZACION) @map("tipo_acceso")
  mfaVerificado   Boolean          @default(false) @map("mfa_verificado")
  mfaVerificadoEn DateTime?        @map("mfa_verificado_en")
  ipOrigen        String?          @map("ip_origen")
  userAgent       String?          @map("user_agent")
  expiraEn        DateTime         @map("expira_en")
  revocadaEn      DateTime?        @map("revocada_en")
  creadoEn        DateTime         @default(now()) @map("creado_en")
  usuario         Usuario          @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId, tipoAcceso, revocadaEn])
  @@map("sesiones")
}

model SesionFotografica {
  id             String                  @id @default(uuid()) @db.Uuid
  organizacionId String                  @map("organizacion_id") @db.Uuid
  clienteId      String                  @map("cliente_id") @db.Uuid
  nombre         String
  descripcion    String?
  fecha          DateTime?               @db.Date
  estado         EstadoSesionFotografica @default(BORRADOR)
  portadaFotoId  String?                 @map("portada_foto_id") @db.Uuid
  creadoEn       DateTime                @default(now()) @map("creado_en")
  actualizadoEn  DateTime                @updatedAt @map("actualizado_en")
  organizacion   Organizacion            @relation(fields: [organizacionId], references: [id], onDelete: Cascade)
  cliente        Cliente                 @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  fotos          FotoSesion[]

  @@index([organizacionId, estado])
  @@index([clienteId])
  @@map("sesiones_fotograficas")
}

model FotoSesion {
  id                String            @id @default(uuid()) @db.Uuid
  sesionId          String            @map("sesion_id") @db.Uuid
  almacenamientoKey String            @unique @map("almacenamiento_key")
  miniaturaKey      String?           @map("miniatura_key")
  nombreOriginal    String            @map("nombre_original")
  tipoMime          String            @map("tipo_mime")
  tamanoBytes       Int               @map("tamano_bytes")
  orden             Int               @default(0)
  creadoEn          DateTime          @default(now()) @map("creado_en")
  sesion            SesionFotografica @relation(fields: [sesionId], references: [id], onDelete: Cascade)

  @@index([sesionId, orden])
  @@map("fotos_sesion")
}

model SolicitudRecuperacion {
  id        String    @id @default(uuid()) @db.Uuid
  usuarioId String    @map("usuario_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiraEn  DateTime  @map("expira_en")
  usadoEn   DateTime? @map("usado_en")
  creadoEn  DateTime  @default(now()) @map("creado_en")
  usuario   Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId])
  @@index([tokenHash])
  @@index([expiraEn])
  @@map("solicitudes_recuperacion")
}

model CodigoRecuperacionMfa {
  id         String    @id @default(uuid()) @db.Uuid
  usuarioId  String    @map("usuario_id") @db.Uuid
  codigoHash String    @map("codigo_hash")
  usadoEn    DateTime? @map("usado_en")
  creadoEn   DateTime  @default(now()) @map("creado_en")
  usuario    Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId, usadoEn])
  @@map("codigos_recuperacion_mfa")
}

model SolicitudRecuperacionMfa {
  id        String    @id @default(uuid()) @db.Uuid
  usuarioId String    @map("usuario_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiraEn  DateTime  @map("expira_en")
  usadoEn   DateTime? @map("usado_en")
  creadoEn  DateTime  @default(now()) @map("creado_en")
  usuario   Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId])
  @@index([expiraEn])
  @@map("solicitudes_recuperacion_mfa")
}

model AuditoriaAdmin {
  id             String   @id @default(uuid()) @db.Uuid
  actorUsuarioId String?  @map("actor_usuario_id") @db.Uuid
  actorCorreo    String?  @map("actor_correo")
  accion         String
  entidad        String
  entidadId      String?  @map("entidad_id")
  organizacionId String?  @map("organizacion_id") @db.Uuid
  resultado      String   @default("EXITO")
  ip             String?
  userAgent      String?  @map("user_agent")
  metadatos      Json?
  creadoEn       DateTime @default(now()) @map("creado_en")
  actorUsuario   Usuario? @relation("AuditoriaActor", fields: [actorUsuarioId], references: [id], onDelete: SetNull)

  @@index([actorUsuarioId, creadoEn])
  @@index([accion, creadoEn])
  @@index([entidad, entidadId])
  @@index([organizacionId, creadoEn])
  @@map("auditoria_admin")
}

model PlanSuscripcion {
  id                    String                    @id @default(uuid()) @db.Uuid
  codigo                String                    @unique
  nombre                String
  descripcion           String?
  activo                Boolean                   @default(true)
  esPlanPrueba          Boolean                   @default(false) @map("es_plan_prueba")
  duracionSugeridaDias  Int?                      @map("duracion_sugerida_dias")
  caracteristicas       Json?
  orden                 Int                       @default(0)
  creadoPorUsuarioId    String?                   @map("creado_por_usuario_id") @db.Uuid
  actualizadoPorUsuarioId String?                 @map("actualizado_por_usuario_id") @db.Uuid
  creadoEn              DateTime                  @default(now()) @map("creado_en")
  actualizadoEn         DateTime                  @updatedAt @map("actualizado_en")
  creadoPorUsuario      Usuario?                  @relation("PlanCreadoPor", fields: [creadoPorUsuarioId], references: [id], onDelete: SetNull)
  actualizadoPorUsuario Usuario?                  @relation("PlanActualizadoPor", fields: [actualizadoPorUsuarioId], references: [id], onDelete: SetNull)
  suscripciones         SuscripcionOrganizacion[]
  historialAnterior     HistorialSuscripcion[]    @relation("HistorialPlanAnterior")
  historialNuevo        HistorialSuscripcion[]    @relation("HistorialPlanNuevo")

  @@index([activo, orden])
  @@map("planes_suscripcion")
}

model SuscripcionOrganizacion {
  id                   String                 @id @default(uuid()) @db.Uuid
  organizacionId       String                 @unique @map("organizacion_id") @db.Uuid
  planId               String?                @map("plan_id") @db.Uuid
  estado               EstadoSuscripcion      @default(SIN_SUSCRIPCION)
  fechaInicio          DateTime?              @map("fecha_inicio")
  fechaFin             DateTime?              @map("fecha_fin")
  motivo               String?
  notasInternas        String?                @map("notas_internas")
  referenciaManual     String?                @map("referencia_manual")
  asignadoPorUsuarioId String?                @map("asignado_por_usuario_id") @db.Uuid
  asignadoEn           DateTime?              @map("asignado_en")
  canceladaPorUsuarioId String?               @map("cancelada_por_usuario_id") @db.Uuid
  canceladaEn          DateTime?              @map("cancelada_en")
  motivoCancelacion    String?                @map("motivo_cancelacion")
  creadoEn             DateTime               @default(now()) @map("creado_en")
  actualizadoEn        DateTime               @updatedAt @map("actualizado_en")
  organizacion         Organizacion           @relation(fields: [organizacionId], references: [id], onDelete: Cascade)
  plan                 PlanSuscripcion?       @relation(fields: [planId], references: [id], onDelete: Restrict)
  asignadoPorUsuario   Usuario?               @relation("SuscripcionAsignadaPor", fields: [asignadoPorUsuarioId], references: [id], onDelete: SetNull)
  canceladaPorUsuario  Usuario?               @relation("SuscripcionCanceladaPor", fields: [canceladaPorUsuarioId], references: [id], onDelete: SetNull)
  historial            HistorialSuscripcion[]

  @@index([estado, fechaFin])
  @@index([planId])
  @@map("suscripciones_organizacion")
}

model HistorialSuscripcion {
  id                   String                   @id @default(uuid()) @db.Uuid
  suscripcionId        String                   @map("suscripcion_id") @db.Uuid
  organizacionId       String                   @map("organizacion_id") @db.Uuid
  accion               String
  estadoAnterior       EstadoSuscripcion?       @map("estado_anterior")
  estadoNuevo          EstadoSuscripcion        @map("estado_nuevo")
  planAnteriorId       String?                  @map("plan_anterior_id") @db.Uuid
  planNuevoId          String?                  @map("plan_nuevo_id") @db.Uuid
  fechaInicioAnterior  DateTime?                @map("fecha_inicio_anterior")
  fechaInicioNueva     DateTime?                @map("fecha_inicio_nueva")
  fechaFinAnterior     DateTime?                @map("fecha_fin_anterior")
  fechaFinNueva        DateTime?                @map("fecha_fin_nueva")
  motivo               String?
  notas                String?
  metadatos            Json?
  realizadoPorUsuarioId String?                 @map("realizado_por_usuario_id") @db.Uuid
  realizadoPorCorreo   String?                  @map("realizado_por_correo")
  creadoEn             DateTime                 @default(now()) @map("creado_en")
  suscripcion          SuscripcionOrganizacion  @relation(fields: [suscripcionId], references: [id], onDelete: Cascade)
  organizacion         Organizacion             @relation(fields: [organizacionId], references: [id], onDelete: Cascade)
  planAnterior         PlanSuscripcion?         @relation("HistorialPlanAnterior", fields: [planAnteriorId], references: [id], onDelete: SetNull)
  planNuevo            PlanSuscripcion?         @relation("HistorialPlanNuevo", fields: [planNuevoId], references: [id], onDelete: SetNull)
  realizadoPorUsuario  Usuario?                 @relation("HistorialSuscripcionUsuario", fields: [realizadoPorUsuarioId], references: [id], onDelete: SetNull)

  @@index([organizacionId, creadoEn])
  @@index([suscripcionId, creadoEn])
  @@index([realizadoPorUsuarioId])
  @@map("historial_suscripciones")
}

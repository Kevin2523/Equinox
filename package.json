{
  "name": "equinox-api",
  "version": "1.0.0",
  "private": true,
  "description": "API de Equinox, CRM para freelancers en Panamá",
  "scripts": {
    "desarrollo": "node node_modules/tsx/dist/cli.mjs watch src/servidor.ts",
    "compilar": "node node_modules/typescript/bin/tsc -p tsconfig.json",
    "iniciar": "node dist/servidor.js",
    "prisma:generar": "node node_modules/prisma/build/index.js generate",
    "prisma:migrar": "node node_modules/prisma/build/index.js migrate dev",
    "prisma:desplegar": "node node_modules/prisma/build/index.js migrate deploy",
    "prisma:semilla": "node node_modules/tsx/dist/cli.mjs prisma/seed.ts",
    "prisma:verificar-semilla": "node node_modules/tsx/dist/cli.mjs prisma/verificar-semilla.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.16.1",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/node": "^24.5.2",
    "prisma": "^6.16.1",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}

PUERTO=3000
ENTORNO=desarrollo
URL_BASE=http://localhost:4200
ORIGENES_PERMITIDOS=http://localhost:4200
DATABASE_URL="postgresql://usuario:contrasena@localhost:5432/equinox?schema=public"
SECRETO_JWT="cambia-esto-por-un-secreto-largo-y-aleatorio"
VENCIMIENTO_JWT="7d"

# Semilla de demostración (exclusivo para desarrollo local)
PERMITIR_SEMILLA_DEMO=false
CONTRASENA_DEMO="contrasena_demo_local_123"
TOKEN_INVITACION_DEMO="token_invitacion_demo_dev_123"

# Configuración de proxy inverso (opcional):
# Acepta únicamente: false, 0, o un entero positivo acotado (1 a 10) representando la cantidad de saltos de confianza.
# Valor predeterminado y seguro para ejecución directa: false
CONFIAR_PROXY=false

# Expiración de invitaciones a clientes en horas (opcional):
# Entero positivo de 1 a 720 (30 días). Valor predeterminado seguro: 168 (7 días).
VENCIMIENTO_INVITACION_HORAS=168

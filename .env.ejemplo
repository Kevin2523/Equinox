PUERTO=3000
ENTORNO=desarrollo
URL_BASE=http://localhost:4200
ORIGENES_PERMITIDOS=http://localhost:4200
DATABASE_URL="postgresql://usuario:contrasena@localhost:5432/equinox?schema=public"
SECRETO_JWT="cambia-esto-por-un-secreto-largo-y-aleatorio"
VENCIMIENTO_JWT="7d"

# Semilla de demostración (exclusivo para desarrollo local)
PERMITIR_SEMILLA_DEMO=false
CONTRASENA_DEMO="contrasena_demo_local_123"
TOKEN_INVITACION_DEMO="token_invitacion_demo_dev_123"

# Configuración de proxy inverso (opcional):
# Acepta únicamente: false, 0, o un entero positivo acotado (1 a 10) representando la cantidad de saltos de confianza.
# Valor predeterminado y seguro para ejecución directa: false
CONFIAR_PROXY=false

# Expiración de invitaciones a clientes en horas (opcional):
# Entero positivo de 1 a 720 (30 días). Valor predeterminado seguro: 168 (7 días).
VENCIMIENTO_INVITACION_HORAS=168

# Almacenamiento privado de fotos (modalidad FOTOGRAFIA):
# Directorio privado en disco fuera del webroot para almacenar fotos de sesiones fotográficas.
ALMACENAMIENTO_FOTOS_DIR="./almacenamiento_privado/fotos"
# Tamaño máximo permitido por foto en bytes (ej. 52428800 = 50MB):
ALMACENAMIENTO_MAX_BYTES=52428800

# Configuración de Correo Saliente (SMTP / Recuperación de contraseña):
# Para habilitar el envío real de correos (enlaces de recuperación y notificaciones),
# configure el servidor SMTP correspondiente. Si SMTP_HOST no está definido, el
# endpoint de recuperación responde 503 informando que el canal no está configurado.
SMTP_HOST=""
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Equinox <no-reply@equinox.app>"

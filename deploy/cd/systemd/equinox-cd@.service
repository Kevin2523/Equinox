[Unit]
Description=Equinox Pull-Based CD (%i)
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service

[Service]
Type=oneshot
User=root
Group=root
Environment=HOME=/var/lib/equinox-cd
EnvironmentFile=/etc/equinox-cd/%i.env
ExecStart=/usr/local/sbin/equinox-cd-pull.sh
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
TimeoutStartSec=300
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target

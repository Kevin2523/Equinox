# ==============================================================================
# Plantilla de configuración para /etc/equinox-cd/<env>.env (permisos 0600 root:root)
# Copiar a:
#   /etc/equinox-cd/staging.env
#   /etc/equinox-cd/production.env
# ==============================================================================

# --- Ejemplo para STAGING (develop -> localhost:8081) ---
ENV_NAME=staging
APP_DIR=/opt/equinox-staging
COMPOSE_PROJECT_NAME=equinox-staging
BACKEND_IMAGE=ghcr.io/kevin2523/equinox-backend
FRONTEND_IMAGE=ghcr.io/kevin2523/equinox-frontend
IMAGE_TAG=staging

# Identidad exacta del workflow OIDC permitida por Cosign:
# - Staging:    https://github.com/Kevin2523/Equinox/.github/workflows/cd-staging.yml@refs/heads/develop
# - Producción: https://github.com/Kevin2523/Equinox/.github/workflows/cd-production.yml@refs/heads/main
ALLOWED_WORKFLOW_REF=https://github.com/Kevin2523/Equinox/.github/workflows/cd-staging.yml@refs/heads/develop
VERIFY_COSIGN=true

# Puerto local donde expone Nginx del compose (8081 staging, 8082 producción)
FRONTEND_BIND_IP=127.0.0.1
FRONTEND_PORT=8081
HEALTH_TIMEOUT_SEC=60
HEALTH_INTERVAL_SEC=3

# Opcional: solo necesario si el paquete GHCR pasa a ser privado
# GHCR_READ_USER=
# GHCR_READ_TOKEN=
